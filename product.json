{
  "name": "Phone Number Checker API",
  "brand": "CheckNumber",
  "slug": "phone-number-checker-api",
  "repository": "checkernumber/phone-number-checker-api",
  "description": "Asynchronous file-based Number Checker checks.",
  "official_site": "https://checknumber.ai",
  "landing_page": "https://checknumber.ai/products/number-checker",
  "canonical_docs": "https://docs.checknumber.ai/phone-number-validation",
  "dashboard": "https://platform.checknumber.ai",
  "base_url": "https://api.checknumber.ai",
  "mode": "async",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "file_format": "text file, one E.164 phone number per line according to task type"
  },
  "products": [
    {
      "task_type": "phoneCheck",
      "name": "Validity Checker",
      "doc_slug": "phone-number-validation",
      "input_kind": "phone",
      "min_numbers": 2000,
      "max_numbers": 10000000,
      "result_fields": [
        "number",
        "activated"
      ]
    },
    {
      "task_type": "active_check",
      "name": "Activity Checker",
      "doc_slug": "number-active-check",
      "input_kind": "phone",
      "min_numbers": 2000,
      "max_numbers": 10000000,
      "result_fields": [
        "number",
        "activated"
      ]
    },
    {
      "task_type": "high_value_users",
      "name": "High-Value Checker",
      "doc_slug": "high-value-users-checker",
      "input_kind": "phone",
      "min_numbers": 1000,
      "max_numbers": 500000,
      "result_fields": [
        "Mobile Number",
        "Result"
      ]
    }
  ],
  "pricing_url": "https://checknumber.ai/pricing",
  "maintainer": "CheckNumber",
  "license": "MIT",
  "last_reviewed": "2026-08-18"
}
